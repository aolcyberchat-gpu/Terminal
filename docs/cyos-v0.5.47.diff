   function getAlpha(id) {
     const a = S.alphas[id];
     return typeof a === "number" ? clampAlpha(a) : 1;
   }
+
+  // Report the CSS background opacity selected for each surface.
+  // Theater applies a 76% multiplier only to Chat's buffer and input.
+  function alphaState(id) {
+    const configured = getAlpha(id);
+    const theaterChat = id === "chat" && S.mode === "theater";
+    return {
+      configured,
+      frame: configured,
+      content: theaterChat ? configured * 0.76 : configured,
+      userlist: configured,
+      theaterOverride: theaterChat
+    };
+  }
+
+  function alphaReport(id) {
+    const st = alphaState(id), pct = (v) => Math.round(v * 100) + "%";
+    if (id === "chat") {
+      return "configured " + pct(st.configured) +
+        " | frame/title " + pct(st.frame) +
+        " | buffer/input " + pct(st.content) +
+        (st.theaterOverride ? " (theater ×76%)" : "") +
+        (S.users ? " | userlist " + pct(st.userlist) : "");
+    }
+    return "configured/effective " + pct(st.configured);
+  }
